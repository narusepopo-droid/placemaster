rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가입 신청 - 누구나 쓰기 가능, 인증된 사용자만 읽기
    match /signups/{document} {
      allow write: if true;
      allow read: if request.auth != null;
    }

    // 사용자 정보 - 인증된 사용자만 접근
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // SMS 대기열 - 인증된 사용자만 접근
    match /sms_queue/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
