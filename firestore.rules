rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 플레이스마스터 PRO(PC 프로그램) 종료 (2026-10-29 요청자: 플마 모두 삭제, 프로그램 못 쓰게)
    // → 마스터(광고토대왕) 계정 말고는 아무도 읽기·쓰기 불가. 예전 규칙은 git 기록에 있음
    function isMaster() {
      return request.auth != null && request.auth.uid == '104K4S7E4bNm9Cl4dQsg7Sz18Zf1';
    }
    match /{document=**} {
      allow read, write: if isMaster();
    }
  }
}
